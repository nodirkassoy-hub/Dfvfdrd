# BUXAI environment configuration
# Session secret used to sign auth cookies (REQUIRED in production)
BUXAI_SESSION_SECRET=change-me-to-a-long-random-string

# Optional: enable LLM-backed narrative layer for the AI Center.
# The deterministic, ledger-grounded engine is always used for figures.
# When set, it is called from the server only — never exposed to the browser.
# BUXAI_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# BUXAI_LLM_MODEL=gpt-4o-mini

# Storage location for the SQLite database
BUXAI_DB_PATH=./data/buxai.db
